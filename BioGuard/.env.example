# Copy this file to .env (in the same folder as docker-compose.yml) and
# adjust before running `docker compose up`. .env is gitignored; this
# example file is the one that's tracked.
#
# For everything the backend itself understands (not just these
# Docker-Compose-level overrides), see backend/app/config.py.

# Signs issued login tokens. The backend runs fine without this set — it
# falls back to a well-known development value and logs a warning on
# startup — but change it before this leaves your machine.
JWT_SECRET_KEY=dev-secret-change-me-before-deploying-anywhere-real

# Minutes before an issued login token expires.
JWT_EXPIRE_MINUTES=1440

# Path *inside the backend container* to a Firebase service-account JSON,
# for push notifications. Leave empty to disable FCM — readings, alerts,
# and the rest of the app all work without it. Pair with the commented
# volume mount for the "backend" service in docker-compose.yml.
FIREBASE_CREDENTIALS_PATH=

# Host ports. Change these if 1883/8000 are already taken on your machine.
MQTT_PORT=1883
BACKEND_PORT=8000
